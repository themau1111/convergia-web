AUTH_SECRET=generate-a-random-value-at-deploy-time
AUTH_OIDC_ISSUER=https://identity.example.invalid/
AUTH_OIDC_AUDIENCE=urn:convergia:control-api
AUTH_OIDC_CLIENT_ID=convergia-web
AUTH_OIDC_CLIENT_SECRET=resolve-at-runtime
# La integración nativa de Vercel puede aportar como aliases:
# AUTH0_DOMAIN, AUTH0_CLIENT_ID, AUTH0_CLIENT_SECRET y AUTH0_SECRET.
AUTH_PASSWORD_RESET_URL=https://identity.example.invalid/reset
CONTROL_API_URL=http://127.0.0.1:8000
DEPLOYMENT_VERSION=local
